generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  password_hash     String
  name              String?

  preferences       UserPreferences?
  emergencyContacts EmergencyContact[]
  moodEntries       MoodEntry[]
}

model UserPreferences {
  userId        Int    @id
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  selectedTabs  Json   @default("[]")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("user_preferences")
}

model EmergencyContact {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  phone      String?
  relation   String?
  isPrimary  Boolean  @default(false)

  createdAt  DateTime @default(now())

  @@index([userId])
  @@unique([userId, phone])

  @@map("emergency_contacts")
}

model MoodEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  entryDate DateTime
  mood      Int
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, entryDate])
  @@index([userId, entryDate])

  @@map("mood_entries")
}

model CommunityMessage {
  id        Int      @id @default(autoincrement())
  room      String
  userId    Int
  username  String
  message   String
  createdAt DateTime @default(now())

  @@index([room, createdAt])
  @@index([userId])

  @@map("community_messages")
}

model CommunityRoomSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  room      String
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([room])
  @@index([userId])

  @@map("community_room_sessions")
}

model Event {
  id         Int      @id @default(autoincrement())
  externalId String   @unique
  title      String
  date       String
  location   String
  category   String
  imageUrl   String
  link       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("events")
}
